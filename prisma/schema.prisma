generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BlogPost {
  id             String        @id
  title          String
  slug           String        @unique
  excerpt        String        @default("")
  content        String        @default("")
  coverImageUrl  String?
  tags           String[]      @default([])
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime

  @@index([status, publishedAt])
}

model ContactMessage {
  id        String   @id
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ExperienceEntry {
  id           String         @id
  type         ExperienceType
  title        String
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  description  String         @default("")
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
}

model Project {
  id             String        @id
  title          String
  slug           String        @unique
  summary        String        @default("")
  description    String        @default("")
  coverImageUrl  String?
  galleryUrls    String[]      @default([])
  techTags       String[]      @default([])
  liveUrl        String?
  repoUrl        String?
  order          Int           @default(0)
  featured       Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime

  @@index([status, publishedAt])
}

model SiteSettings {
  id                    String   @id @default("singleton")
  siteName              String   @default("")
  tagline               String   @default("")
  heroHeadline          String   @default("")
  heroSubtext           String   @default("")
  heroImageUrl          String?
  bio                   String   @default("")
  avatarUrl             String?
  resumeFileUrl         String?
  contactEmail          String?
  socialLinks           Json     @default("{}")
  defaultSeoTitle       String   @default("")
  defaultSeoDescription String   @default("")
  ogImageUrl            String?
  updatedAt             DateTime
}

model Skill {
  id        String   @id
  name      String
  category  String
  iconUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Testimonial {
  id              String        @id
  authorName      String
  authorRole      String?
  authorAvatarUrl String?
  quote           String
  order           Int           @default(0)
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ExperienceType {
  WORK
  EDUCATION
}
