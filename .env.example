# Copy to .env.local (Next.js) and .env (Prisma CLI / scripts) and fill in real values.
# Never commit real secrets.

# Postgres connection string (Neon etc.). Read by src/lib/db.ts, prisma.config.ts, scripts/migrate-json-to-db.ts.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret for signing the admin session cookie (src/lib/admin-auth.ts, src/middleware.ts). Use a long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Password for the /admin dashboard (required; login fails if unset).
ADMIN_PASSWORD=change-me

# Cloudinary media storage (src/lib/cloudinary.ts) — server-side only.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact form e-mail notification via Resend (src/app/api/contact/route.ts).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Inbox that receives the notification for each new contact message.
CONTACT_NOTIFICATION_EMAIL=you@example.com

# be_game backend URL used by every online game (Tiến Lên, Mèo Nổ, Cờ Tỷ Phú, Đá Quý, Đấu Súng).
# Inlined at build time. Default when unset: http://localhost:4000
NEXT_PUBLIC_TIENLEN_SERVER_URL=http://localhost:4000
